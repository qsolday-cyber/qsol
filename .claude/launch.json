{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "wasm-test-page",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "wasm/test-page/serve.mjs"
      ],
      "port": 8787
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "web-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "web",
        "run",
        "preview",
        "--",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}